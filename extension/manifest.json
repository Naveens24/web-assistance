{
  "manifest_version": 3,
  "name": "Website Assistant Chatbot",
  "version": "1.0",
  "permissions": ["activeTab"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open Chatbot"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["style.css"],
      "permissions": ["activeTab", "scripting"]
    }
  ]
}